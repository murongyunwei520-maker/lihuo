# 离火后端 · 环境变量示例
# 复制为 .env（已在 .gitignore 中，不会提交）
# 启动时由 node --env-file-if-exists=.env 自动加载

# ---------- 服务自身 ----------
LIHUO_HOST=127.0.0.1
LIHUO_PORT=3100

# ---------- 网关（New-API） ----------
# 根地址，不带 /v1
NEW_API_BASE_URL=http://127.0.0.1:3001
# 平台令牌 sk-，只存在服务端，绝不进前端
NEW_API_KEY=sk-CHANGE_ME
# 管理面令牌（可选）：仅渠道测试、用量拉取需要，约 15 分钟过期
NEW_API_ADMIN_TOKEN=

# ---------- 数据库 ----------
# SQLite 文件路径，相对 server 目录
LIHUO_DB_PATH=data/lihuo.db

# ---------- 账号与会话 ----------
# 是否开放自助注册；默认关闭，用户由管理员创建
LIHUO_ALLOW_REGISTER=false
# 首个管理员；密码留空则自动生成并写入 data/.bootstrap-admin.txt
LIHUO_ADMIN_USERNAME=admin
LIHUO_ADMIN_PASSWORD=
# 会话有效期（小时）
LIHUO_SESSION_TTL_HOURS=168
# 上 HTTPS 后置为 true（Cookie 加 Secure）
LIHUO_COOKIE_SECURE=false

# ---------- 登录限流 ----------
LIHUO_LOGIN_MAX_ATTEMPTS=8
LIHUO_LOGIN_WINDOW_SECONDS=300

# ---------- CORS ----------
# 前端来源，逗号分隔。生产环境改成正式域名
LIHUO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
