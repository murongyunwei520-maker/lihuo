{
  "name": "@lihuo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "离火统一业务后端：用户、权限、额度、计费、模型注册与网关代理",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types --experimental-sqlite src/index.ts",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --experimental-sqlite --watch src/index.ts",
    "smoke": "node --env-file-if-exists=.env --experimental-strip-types smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
